<Window x:Class="Project_KTPMUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Project_KTPMUD"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid Height="584" VerticalAlignment="Center">
        <Grid.Background>
            <ImageBrush ImageSource="Images/country.jpg" Stretch="UniformToFill" Opacity="0.5" />
        </Grid.Background>
        <Grid Width="600" Height="540" Background="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="390,0,0,0" Opacity="0.9" >
            <Grid Width="580" Height="520" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Opacity="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="175"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FF196050" CornerRadius="8">
                    <Label Content="QUẢN LÝ VỆ SINH MÔI TRƯỜNG NÔNG THÔN"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#FFF"/>
                </Border>

                <Border Grid.Row="2" Background="#FF9ACF87" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                        </Grid.RowDefinitions>

                        <!-- Tiêu đề -->
                        <Label Content="Vui lòng chọn vai trò đăng nhập:"
                               Grid.Row="0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FF212220" Margin="10,0,0,0" />

                        <RadioButton x:Name="AdminRadioButton" Content="Người xem"
                                     GroupName="Roles"
                                     FontSize="18"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Margin="20,0,0,39"
                                     Grid.Row="2" Grid.RowSpan="2" />

                        <RadioButton x:Name="XaRadioButton" Content="Đơn vị hành chính cấp Xã"
                                     GroupName="Roles"
                                     FontSize="18"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Margin="20,10,0,0"
                                     Grid.Row="3" />

                        <RadioButton x:Name="HuyenRadioButton" Content="Đơn vị hành chính cấp Huyện"
                                     GroupName="Roles"
                                     FontSize="18"
                                     VerticalAlignment="Center"
                                     HorizontalAlignment="Left"
                                     Margin="20,10,0,0"
                                     Grid.Row="4" />
                    </Grid>
                </Border>

                <Border Grid.Row="4" Background="#FF9ACF87" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="45"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0">
                            <Label Content="Tên đăng nhập *"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="10,0,0,0"/>
                        </Border>

                        <Border Grid.Row="1" Height="45" VerticalAlignment="Top" CornerRadius="10" BorderBrush="Gray" BorderThickness="1" Background="White" Margin="10,0,28,0">
                            <TextBox 
        x:Name="txtUsername"
        VerticalAlignment="Center"
        BorderThickness="0"
        FontSize="16"
        VerticalContentAlignment="Center"
        HorizontalContentAlignment="Left"
        MinWidth="200" 
        Height="35" 
        TextChanged="txtUsername_TextChanged" 
        Background="Transparent" HorizontalAlignment="Left" Width="540" />
                        </Border>

                        <Border Grid.Row="2">
                            <Label Content="Mật khẩu *"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Margin="10,0,0,0"/>
                        </Border>

                        <Border Grid.Row="3" Height="45" VerticalAlignment="Top" CornerRadius="10" BorderBrush="Gray" BorderThickness="1" Background="White"  Margin="10,0,28,0">

                            <PasswordBox
                                         x:Name="txtPassword"
                                         VerticalAlignment="Center"
                                BorderThickness="0"
                                         Margin="10,0,28,0"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Left"
                                         MinWidth="200" Height="35"
                                Background="Transparent"/>
                        </Border>
                    </Grid>

                </Border>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#FF63D5F1" CornerRadius="8" Margin="0,0,5,0">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Nút Đăng Nhập -->
                            <Button x:Name="LogInButton"
                Click="LogInButton_Click"
                Content="ĐĂNG NHẬP"
                FontSize="30"
                FontWeight="Bold"
                Background="{x:Null}"
                Foreground="#FF133864"
                HorizontalAlignment="Center"
                Width="580" Height="50"
                BorderBrush="{x:Null}" />

                            <!-- Nút Quên Mật Khẩu -->
                            <Button x:Name="ForgotPasswordButton"
                Click="ForgotPasswordButton_Click"
                Content="*Quên mật khẩu"
                FontSize="16"
                Background="{x:Null}"
                Foreground="#FF133864"
                HorizontalAlignment="Center"
                BorderBrush="{x:Null}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="Aquamarine" CornerRadius="8" Opacity="1" Margin="0,0,5,0">
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Nút đăng ký-->
                            <Button x:Name="SignUpButton"
                                    Click="SignUpButton_Click"
                                    Content="ĐĂNG KÝ"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Background="{x:Null}"
                                    Foreground="#FF133864"
                                    HorizontalAlignment="Center"
                                    Width="580" Height="50"
                                    BorderBrush="{x:Null}"/>
                            <Label Content="Nếu chưa có tài khoản"
                                   FontSize="16"
                                   Background="{x:Null}"
                                   Foreground="#FF133864"
                                   HorizontalAlignment="Center"
                                   BorderBrush="{x:Null}"/>
                        </StackPanel>
                    </Border>

                </Grid>


            </Grid>


        </Grid>



    </Grid>
</Window>